ples":[{"sec":1320.286,"text":"해방무적 써바여"},{"sec":1320.759,"text":"{:d_54:}{:d_54:}{:d_54:}{:d_54:}"},{"sec":1321.243,"text":"이제 제네무적까지"},{"sec":1321.377,"text":"오른쪽으로 퇴장"}]},{"start_sec":1350,"end_sec":1380,"count":47,"laughter_count":12,"surprise_count":4,"samples":[{"sec":1350.248,"text":"ㅇㄱㅇ"},{"sec":1350.272,"text":"ㄹㅇ ㄹㅇ"},{"sec":1350.483,"text":"자동돌리기하면 알아서 돈 나감 ㅋㅋ"},{"sec":1350.642,"text":"아니 자동으로 돌리면되는데 ~~~"}]}],"subtitles":[{"start_sec":282.836,"end_sec":301.971,"text":"저 10포인트 남았거든요? 막 데미안 같은 거 잡으면 돼요.","index":1},{"start_sec":301.971,"end_sec":324.467,"text":"아, 네 씨. 다 까먹었는데 잡을 수 있냐?","index":2},{"start_sec":324.468,"end_sec":338.163,"text":"끼는 곳에 원래 뭐 끼지? 상관없나?","index":3},{"start_sec":338.163,"end_sec":339.187,"text":"나 저거, 저거 껴가지고 벗겨진 건 아니겠지?","index":4},{"start_sec":339.187,"end_sec":359.923,"text":"명찰? 뭐가 빠진 것인가나?","index":5},{"start_sec":359.923,"end_sec":374.835,"text":"저는 악세 끼세요.","index":6},{"start_sec":374.836,"end_sec":393.875,"text":"진압쇠? 어딨는지 모르겠는데? 아씨... 아이고?","index":7},{"start_sec":393.875,"end_sec":414.675,"text":"아이고.","index":8},{"start_sec":414.675,"end_sec":425.459,"text":"사악한 캐시 차이가 어떻게 찾냐? 어떻게 생겼나요? 어디냐?","index":9},{"start_sec":425.459,"end_sec":442.227,"text":"아, 이거야?","index":10},{"start_sec":442.228,"end_sec":462.771,"text":"이러면 다 껴진 건가? 번쩍, 번 쩍x2","index":11},{"start_sec":462.771,"end_sec":474.021,"text":"아니 근데 지금 코디할 때가 아니야?","index":12},{"start_sec":474.021,"end_sec":474.739,"text":"빨리 잡고 경기봐야 되니까 일단 급한대로 벌써 특이하게 가더라.","index":13},{"start_sec":474.74,"end_sec":481.299,"text":"보스, 하고, 수우를 잡아. 수, 수우.","index":14},{"start_sec":481.3,"end_sec":491.527,"text":"하고 하늘만 잡으면 되죠?","index":15},{"start_sec":491.527,"end_sec":491.795,"text":"저 익스트림은 못 잡으니까 야 무조건 수우가 빠르지.","index":16},{"start_sec":491.795,"end_sec":503.507,"text":"데미안은 애가 너무 느려.","index":17},{"start_sec":503.507,"end_sec":522.862,"text":"막 도핑 안해도 되나? 몰라, 나 어느정도인지 이게 그냥 저 편인데요?","index":18},{"start_sec":522.862,"end_sec":524.947,"text":"근데 나 스키 다 까먹었는데요, 괜찮냐?","index":19},{"start_sec":524.947,"end_sec":545.331,"text":"빌드에 어떻게 들어가냐?","index":20},{"start_sec":545.331,"end_sec":559.283,"text":"씻겼어.","index":21},{"start_sec":559.283,"end_sec":570.995,"text":"이거 하드구.","index":22},{"start_sec":570.995,"end_sec":580.531,"text":"그... 키보드가 좀 작은키보드랑 그 막...","index":23},{"start_sec":580.532,"end_sec":590.13,"text":"잠시만요. 인서트 없는디? 아니, 템키는 아니고","index":24},{"start_sec":590.131,"end_sec":596.268,"text":"그것만 없어요.","index":25},{"start_sec":596.268,"end_sec":599.667,"text":"그 외딴섬, 그 막 삼삼으로 돼 있는 애들 있죠? 그게 없는데?","index":26},{"start_sec":599.668,"end_sec":614.899,"text":"오 쉣. 그냥 들어가서 T를 누르라고?","index":27},{"start_sec":614.899,"end_sec":623.859,"text":"베이플라면 키보드 바꿔야겠는데?","index":28},{"start_sec":623.86,"end_sec":637.193,"text":"스피 진짜 다 까먹었어, 진짜 구라하니구.","index":29},{"start_sec":633.652,"end_sec":644.562,"text":"이 펑크는 뭐였냐? 스킬 뭘로 눌러? 아, A. 그리고? 에, A 맞냐?","index":30},{"start_sec":644.563,"end_sec":653.811,"text":"엑소가 창날리는 거였고... D는 뭐냐? 또 무적이냐? 공 어떻게 소환하냐?","index":31},{"start_sec":653.812,"end_sec":668.13,"text":"딜리트 없는데 어떡하냐? 아 여깄다.","index":32},{"start_sec":663.892,"end_sec":673.171,"text":"왜 안 먹냐 가볼냐?","index":33},{"start_sec":673.172,"end_sec":703.172,"text":"물약을 어떻게 먹어? 나 왜 물약 안 마셔?","index":34},{"start_sec":711.443,"end_sec":719.507,"text":"나 무함을 약 받았는데 패턴지 안 껴놨나봐. 아이씨, 나 나갈래.","index":35},{"start_sec":719.508,"end_sec":747.987,"text":"아, 내 말짱을 다 까먹었다고... 요 펠 어떻게 눌러?","index":36},{"start_sec":747.988,"end_sec":771.187,"text":"되지?","index":37},{"start_sec":771.187,"end_sec":789.267,"text":"공 어떻게 꺼내? 아이씨, 잠시만요. 나 공을 어떻게 거내야 되지?","index":38},{"start_sec":789.268,"end_sec":798.355,"text":"못 꺼내는 거구나? 얜 뭐냐 그러면? 일단 페이지 업해둬. 페이지업은 있어.","index":39},{"start_sec":798.355,"end_sec":807.667,"text":"그 다음에 O가 6차 궁극기 그거지 K는 파운틴이고 L은","index":40},{"start_sec":807.668,"end_sec":822.13,"text":"허프.","index":41},{"start_sec":822.131,"end_sec":841.747,"text":"히힛. 뭐 뭐 주신 거잖아?","index":42},{"start_sec":841.748,"end_sec":852.307,"text":"오완아, 진짜 하나도요. 붕어빵 감사합니다.","index":43},{"start_sec":852.307,"end_sec":867.795,"text":"그 빔 쏘는 거였나? 오케이. 뭔 노말이야, 씨.","index":44},{"start_sec":867.796,"end_sec":873.688,"text":"아르르르르 였다고?","index":45},{"start_sec":873.688,"end_sec":886.546,"text":"그거는 근데 이 1패에서 쓰는게 아니어라,","index":46},{"start_sec":886.546,"end_sec":887.219,"text":"어, 백딜은 2패으로 쓰야되지 않아요?","index":47},{"start_sec":887.22,"end_sec":917.22,"text":"이거 다 찾으니까 그냥 한 번만 갈겨도 되지 않나? 멘트 채우면 될까?","index":48},{"start_sec":927.86,"end_sec":957.86,"text":"아, 네...","index":49},{"start_sec":988.947,"end_sec":1018.947,"text":"끝인데? 와, 몽칼축! 그다음에 여기서 그냥","index":50},{"start_sec":1071.892,"end_sec":1085.225,"text":"어떻게 깨야 되는데. 그냥 Q 없이 할까?","index":51},{"start_sec":1081.556,"end_sec":1111.556,"text":"이렇게 됐고, 1번 누르고, W, E, 아르르르.","index":52},{"start_sec":1121.332,"end_sec":1151.332,"text":"이 기억 안 나요. 아, 5번이 바인드였나?","index":53},{"start_sec":1162.324,"end_sec":1174.227,"text":"여정이었어요. 역시 용사가 되는 길은 멀고도 허나군요.","index":54},{"start_sec":1174.228,"end_sec":1192.04,"text":"지누가 오늘 큐브 돌리라고 한 게, 오늘 미라클이라고 그러는 거야?","index":55},{"start_sec":1186.579,"end_sec":1199.666,"text":"아이씨 근데 미러클이 해야 되겠네.","index":56},{"start_sec":1199.667,"end_sec":1229.667,"text":"어떻게 하라고요? 착용하고 있는 제해싯의 무기를 해제하라고?","index":57},{"start_sec":1263.796,"end_sec":1290.547,"text":"그럼 이따 경기 다 보고 큐브 좀 돌리지 뭐.","index":58},{"start_sec":1290.548,"end_sec":1301.651,"text":"과연 금톨이야?","index":59},{"start_sec":1301.652,"end_sec":1308.338,"text":"그게 뭔데? 등원 말고는 미라클 상관없어요?","index":60},{"start_sec":1308.339,"end_sec":1320.371,"text":"등업만 한거면 이따 경기 끝나고 후딱 등업시 키고 월드컵하면 되겠네.","index":61},{"start_sec":1320.372,"end_sec":1348.722,"text":"텐다 그러면 이제 나고치지.","index":62},{"start_sec":1348.723,"end_sec":1365.705,"text":"금방 끝난다고 하지만 여러분, 3분 남았어요, 경기.","index":63},{"start_sec":1358.771,"end_sec":1377.695,"text":"경기가 더 금방 시작해요. 경기 끝나고 해도 안 도망가요, 미라클 데이.","index":64},{"start_sec":1375.955,"end_sec":1378.739,"text":"약간 동떨어진...","index":65},{"start_sec":1378.74,"end_sec":1394.497,"text":"선수 다 그런 부분에서 빼는 선수들이 아니거든요. 젊은 장수란 표현 자주 하시잖아요, 시우!","index":66},{"start_sec":1394.497,"end_sec":1396.012,"text":"그렇죠.","index":67},{"start_sec":1396.012,"end_sec":1408.74,"text":"특히나 솔로킬 기록에서 시우 선수가 굉장히 좋은 모습을 또 보이고 있습니다.","index":68}],"edit_export_preview":{"schema_version":"edit_export_preview.v1","status":"UNVERIFIED","source":"segment_ledger","clip_count":0,"fps":30,"clips":[],"edl":"TITLE: CHZZK SEGMENT PREVIEW\nFCM: NON-DROP FRAME","otio":{"schema_version":"otio-preview/1","name":"13143299 segment preview","tracks":[{"kind":"Video","clips":[]}]},"validation":{"schema_version":"edit_export_preview.v1.validation","status":"fail","failures":[{"code":"NO_EXPORT_CLIPS","message":"no timeline/highlight spans available"}]}},"lanes":[{"key":"chat_laughter","label":"웃음/놀람","event_count":1},{"key":"chat_surprise","label":"채팅 몰림","event_count":6},{"key":"subtitle_density","label":"자막 긴 구간","event_count":16},{"key":"existing_segments","label":"기존 요약 구간","event_count":0},{"key":"comment_replay","label":"시청자 댓글","event_count":0},{"key":"viewer_clip","label":"시청자 클립","event_count":0},{"key":"audio_peak","label":"오디오 피크","event_count":0}],"labels":{"existing_segments":"기존 요약 구간","chat_laughter":"웃음/놀람","chat_surprise":"채팅 몰림","comment_replay":"시청자 댓글","viewer_clip":"시청자 클립","audio_peak":"오디오 피크","subtitle_density":"자막 긴 구간","timeline":"기존 요약","highlight":"하이라이트","chapter":"댓글 시간표 후보","highlight_candidate":"반응 후보"},"viewer_labels":{"existing_segments":"요약 본문 장면","chat_laughter":"웃음/놀람 채팅","chat_surprise":"채팅 급증 구간","comment_replay":"댓글 시간표 후보","viewer_clip":"시청자 클립","audio_peak":"소리 튄 장면","subtitle_density":"대사 많은 구간","timeline":"요약 본문 장면","highlight":"하이라이트 후보","chapter":"댓글 시간표 후보","highlight_candidate":"반응 후보","chat":"채팅 반응량"},"colors":{"existing_segments":"rgba(122,162,247,0.86)","chat_laughter":"rgba(247,118,142,0.84)","chat_surprise":"rgba(242,166,200,0.82)","comment_replay":"rgba(187,154,247,0.78)","viewer_clip":"rgba(158,206,106,0.84)","audio_peak":"rgba(224,175,104,0.88)","subtitle_density":"rgba(125,207,255,0.78)","tim